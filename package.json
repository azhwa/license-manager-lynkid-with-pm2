{
  "name": "license-manager-lynkid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "tsx src/node/server.ts",
    "db:migrate": "tsx src/node/migrate.ts",
    "db:import-d1": "tsx src/node/import-d1.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.mjs",
    "db:local": "wrangler d1 execute license-manager-db --local --file=src/db/schema.sql && wrangler d1 migrations apply license-manager-db --local",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@libsql/client": "^0.17.4",
    "dotenv": "^17.4.2",
    "hono": "^4.7.7",
    "tsx": "^4.23.12",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250823.0",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "wrangler": "^4.18.0"
  }
}
