# Node/PM2 runtime configuration. Copy this file to .env on the VPS.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_TIMEZONE=Asia/Jakarta
TURSO_DATABASE_URL=libsql://license-manager-violyn.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-auth-token

# Secrets
LYNK_MERCHANT_KEY=replace-with-lynk-merchant-key
MERCHANT_CONFIG_ENCRYPTION_KEY=replace-with-long-random-encryption-secret
JWT_SECRET=replace-with-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-admin-password
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
TURNSTILE_ENABLED=true
CORS_ORIGIN=http://localhost:5173,https://license-autogas.id-manager.my.id
